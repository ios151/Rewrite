#!name=本机开发服务回环
#!desc=配置[General]中添加参数 include-tun，与 bypass-tun 作用相反：让指定 IPv4 网段进入 Loon 的 TUN，具体实现参考文档：https://nsloon.app/docs/General/#include-tun
#!icon=https://raw.githubusercontent.com/ios151/Rewrite/refs/heads/main/dev-loopback/modules/dev-loopback.png
#!author=官方
#!homepage=https://github.com/ios151/Rewrite
#!loon_version=3.5.3(1007)

[General]
ipv6-vif = auto
include-tun = 10.7.0.1/32

[IP Rewrite]
10.7.0.1 = reflect
